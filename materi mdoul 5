x = set([1,2,3])
y = set([3,4])

# union (menggabungkan)
union = x | y
print("hasil union dari 2 seet:", union)

# intersection (data yang sama di kedua set)
inter_section  = x & y
print("hasil dari 2 seet:",inter_section)

# operasi difference (ada di awal tapi tidak ada di set yang lain)
difference = x - y
print("hasil dari 2 seet:",difference)

# symetric difference (data yang beda di kedua set, namun yang sama akan dibuang)
symetric_difference = x ^ y
print("hasil dari 2 seet:",symetric_difference)
